{
  "headers": [
    {
      "source": "/cdn-proxy/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://121.40.163.80:9000/yida/:path*"
    },
    {
      "source": "/cdn-proxy/:path*",
      "destination": "http://tfuvj8a9x.hn-bkt.clouddn.com/:path*"
    },
    {
      "source": "/((?!api|cdn-proxy|_next|_vercel|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}